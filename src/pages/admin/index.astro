---
// Admin: enquiries dashboard. Auth via Supabase Auth (users created in the
// Supabase Dashboard). Noindex (brief §66) — security comes from auth + RLS,
// never from obscurity. Client-only island; no admin data in static output.
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
const configured = Boolean(SUPABASE_URL && SUPABASE_ANON);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin — NEEL ENTERPRISES</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body class="bg-[#0e1013] text-[#eceeeb] font-sans">
    <main class="mx-auto max-w-5xl px-4 py-10">
      <header class="flex items-center justify-between border-b border-[#2a2e35] pb-4">
        <h1 class="text-xl font-black tracking-tight">NEEL <span class="text-[#f0a437]">ADMIN</span></h1>
        <button id="signout" class="hidden rounded border border-[#2a2e35] px-3 py-1.5 text-sm">Sign out</button>
      </header>

      {!configured && (
        <p class="mt-8 rounded border border-[#f0a437]/50 bg-[#f0a437]/10 p-4 text-sm">
          Admin is not configured: set <code>PUBLIC_SUPABASE_URL</code> and <code>PUBLIC_SUPABASE_ANON_KEY</code>
          at build time (see docs/DEPLOYMENT.md).
        </p>
      )}

      <!-- Login -->
      <form id="login" class={`mt-10 max-w-sm space-y-4 ${configured ? '' : 'hidden'}`}>
        <p class="text-sm text-[#9aa1a8]">Sign in with your admin account.</p>
        <label class="block text-sm font-medium">Email
          <input id="email" type="email" required autocomplete="username"
            class="mt-1 w-full rounded-sm border border-[#2a2e35] bg-[#171a1f] p-2" />
        </label>
        <label class="block text-sm font-medium">Password
          <input id="password" type="password" required autocomplete="current-password"
            class="mt-1 w-full rounded-sm border border-[#2a2e35] bg-[#171a1f] p-2" />
        </label>
        <p id="login-error" class="hidden text-sm text-red-400" role="alert"></p>
        <button class="w-full rounded-sm bg-[#f0a437] px-4 py-2 font-semibold text-[#0e1013]">Sign in</button>
      </form>

      <!-- Dashboard -->
      <section id="dashboard" class="mt-8 hidden">
        <div class="flex items-baseline justify-between">
          <h2 class="text-lg font-bold">Enquiries</h2>
          <span id="count" class="font-mono text-xs text-[#9aa1a8]"></span>
        </div>
        <div id="list" class="mt-4 space-y-3"></div>
      </section>
    </main>

    {configured && (
      <script type="module">
        const { createClient } = await import('@supabase/supabase-js');
        const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL as string;
        const SUPABASE_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string;
        const supabase = createClient(SUPABASE_URL, SUPABASE_ANON, {
          auth: { persistSession: true },
        });

        const login = document.getElementById('login') as HTMLFormElement;
        const dashboard = document.getElementById('dashboard')!;
        const list = document.getElementById('list')!;
        const countEl = document.getElementById('count')!;
        const signout = document.getElementById('signout')!;
        const loginError = document.getElementById('login-error')!;

        login.addEventListener('submit', async (e) => {
          e.preventDefault();
          loginError.classList.add('hidden');
          const email = (document.getElementById('email') as HTMLInputElement).value;
          const password = (document.getElementById('password') as HTMLInputElement).value;
          const { error } = await supabase.auth.signInWithPassword({ email, password });
          if (error) {
            loginError.textContent = error.message;
            loginError.classList.remove('hidden');
          }
        });

        signout.addEventListener('click', () => supabase.auth.signOut());

        supabase.auth.onAuthStateChange((_event, session) => {
          const signedIn = !!session;
          login.classList.toggle('hidden', signedIn);
          dashboard.classList.toggle('hidden', !signedIn);
          signout.classList.toggle('hidden', !signedIn);
          if (signedIn) loadEnquiries();
        });

        async function loadEnquiries() {
          const { data, error } = await supabase
            .from('enquiries')
            .select('*')
            .order('created_at', { ascending: false })
            .limit(200);
          if (error) {
            list.innerHTML = `<p class="text-sm text-red-400">Failed to load: ${error.message}</p>`;
            return;
          }
          countEl.textContent = `${data.length} shown`;
          list.innerHTML = '';
          for (const enq of data) {
            const card = document.createElement('article');
            card.className = 'rounded-sm border border-[#2a2e35] bg-[#171a1f] p-4';
            const statusSelect = document.createElement('select');
            statusSelect.className = 'rounded-sm border border-[#2a2e35] bg-[#0e1013] px-2 py-1 text-xs';
            for (const s of ['new', 'contacted', 'closed']) {
              const o = document.createElement('option');
              o.value = s; o.textContent = s; o.selected = enq.status === s;
              statusSelect.appendChild(o);
            }
            statusSelect.addEventListener('change', async () => {
              const { error: uerr } = await supabase.from('enquiries').update({ status: statusSelect.value }).eq('id', enq.id);
              if (uerr) alert('Update failed: ' + uerr.message);
            });
            card.innerHTML = `
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-semibold">${esc(enq.name)}${enq.company ? ' — ' + esc(enq.company) : ''}</h3>
                <span class="font-mono text-xs text-[#f0a437]">${esc(enq.reference_no)}</span>
              </div>
              <p class="mt-1 text-sm text-[#9aa1a8]">
                ${esc(enq.equipment_type)} · ${esc(enq.requirement)} · ${esc(enq.urgency)} · ${esc(enq.city)}
              </p>
              ${enq.description ? `<p class="mt-2 text-sm text-[#b7bdc6]">${esc(enq.description)}</p>` : ''}
              <p class="mt-2 font-mono text-xs text-[#9aa1a8]">
                ${esc(enq.email)} · ${esc(enq.phone)} · ${new Date(enq.created_at).toLocaleString()}
              </p>`;
            card.querySelector('div')!.after(statusSelect);
            list.appendChild(card);
          }
        }

        function esc(s: unknown): string {
          return String(s ?? '').replace(/[&<>"']/g, (c) =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
        }
      </script>
    )}
  </body>
</html>
