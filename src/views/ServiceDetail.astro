---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { site } from '../config/site';
import { t, type Locale } from '../i18n/ui';
import { enabledServices, getService } from '../content/services';
import { faqs, industries, coverageByCategory } from '../content/misc';
import { whatsappForService, emailLink } from '../utils/links';
import Button from '../components/ui/Button.astro';
import SectionHeading from '../components/typography/SectionHeading.astro';

interface Props { locale?: Locale; slug: string; }
const { locale = 'en' as Locale, slug } = Astro.props;
const service = getService(slug);
if (!service) return Astro.redirect('/404/');
const base = locale === 'en' ? '' : `/${locale}`;
const path = `/services/${slug}/`;
const related = enabledServices().filter((s) => s.slug !== slug && s.category === service.category).slice(0, 3);
const covers = coverageByCategory[service.category] ?? [];
const relevantFaqs = faqs.filter((f) =>
  (service.powerType === 'electric' && /electric|battery/i.test(f.q)) ||
  (service.powerType === 'diesel' && /diesel/i.test(f.q)) ||
  (service.slug === 'spare-parts' && /spare parts/i.test(f.q)) ||
  (service.slug === 'forklift-rental' && /rental/i.test(f.q)) ||
  (service.slug === 'preventive-maintenance' && /preventive/i.test(f.q)) ||
  (service.slug === 'amc' && /maintenance/i.test(f.q)) ||
  (service.slug === 'on-site-service' && /on-site|locations/i.test(f.q))
).slice(0, 4);
---

<BaseLayout locale={locale} path={path} title={`${service.title} — ${site.name}`} description={service.short}>
  <section class="section-pad">
    <div class="container-neel max-w-3xl">
      <Breadcrumbs locale={locale} crumbs={[
        { label: 'Services', href: `${base}/services/` },
        { label: service.title, href: `${base}/services/${slug}/` },
      ]} />

      <p class="label-mono mt-8">{service.powerType === 'electric' ? 'Electric' : service.powerType === 'diesel' ? 'Diesel' : 'All equipment'}</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight md:text-5xl" data-reveal>{service.title}</h1>
      <p class="mt-6 text-lg text-muted" data-reveal style="--reveal-delay: 100ms">{service.long}</p>

      <div class="mt-8 flex flex-wrap gap-3" data-reveal style="--reveal-delay: 200ms">
        <Button href={whatsappForService(service.title)} external>{t(locale, 'cta.whatsapp')}</Button>
        <Button href={emailLink(`${service.title} enquiry`)} variant="quiet">{t(locale, 'cta.email')}</Button>
        <Button href={`${base}/request-service/`} variant="outline">{t(locale, 'cta.requestService')}</Button>
      </div>
    </div>
  </section>

  <section class="section-pad hairline bg-sunken/40">
    <div class="container-neel max-w-3xl" data-reveal>
      <SectionHeading eyebrow="Scope" title="What this service covers" />
      <ul class="mt-6 space-y-3">
        {covers.map((c) => <li class="flex gap-3 text-muted"><span class="font-mono text-accent" aria-hidden="true">—</span>{c}</li>)}
      </ul>
    </div>
  </section>

  <section class="section-pad hairline">
    <div class="container-neel max-w-3xl" data-reveal>
      <SectionHeading eyebrow="Where" title="Locations" />
      <p class="mt-4 text-muted">{site.coverageNote}</p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {site.addresses.map((a) => (
          <li class="card">
            <a href={`${base}/locations/${a.id}/`} class="block">
              <p class="label-mono">{a.label}</p>
              <p class="mt-2 font-medium">{a.city}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section-pad hairline bg-sunken/40">
      <div class="container-neel max-w-3xl">
        <SectionHeading eyebrow="Related" title="Related services" />
        <ul class="mt-6 grid gap-4 sm:grid-cols-3">
          {related.map((r) => (
            <li><a href={`${base}/services/${r.slug}/`} class="card"><h3 class="font-semibold">{r.title}</h3></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {relevantFaqs.length > 0 && (
    <section class="section-pad hairline">
      <div class="container-neel max-w-3xl">
        <SectionHeading eyebrow="FAQ" title="Common questions" />
        <div class="mt-6 divide-y divide-line rounded-sm border border-line bg-elevated">
          {relevantFaqs.map((f) => (
            <details class="faq p-4"><summary class="font-medium">{f.q}</summary><p class="mt-2 text-sm text-muted">{f.a}</p></details>
          ))}
        </div>
        <a class="mt-4 inline-block text-sm font-semibold text-accent" href={`${base}/faq/`}>All questions →</a>
      </div>
    </section>
  )}

  <section class="section-pad hairline bg-sunken/40">
    <div class="container-neel max-w-3xl" data-reveal>
      <SectionHeading eyebrow="Industries" title="Industry contexts" />
      <ul class="mt-4 flex flex-wrap gap-2">
        {industries.map((i) => (
          <li><a href={`${base}/industries/${i.slug}/`} class="inline-block rounded-sm border border-line bg-elevated px-3 py-1.5 text-sm hover:border-accent">{i.name}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-neel max-w-3xl rounded-sm border-2 border-ink p-8 text-center" data-reveal>
      <p class="text-xl font-bold">Need {service.title.toLowerCase()}?</p>
      <p class="mt-2 text-muted">Tell us the equipment and the problem — we'll take it from there.</p>
      <Button href={`${base}/request-service/`} class="mt-6">{t(locale, 'cta.requestService')}</Button>
    </div>
  </section>
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.short,
  provider: { '@type': 'Organization', name: site.name, email: site.email, telephone: site.phone },
  areaServed: 'IN',
})} />
