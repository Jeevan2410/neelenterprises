---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { t, type Locale } from '../i18n/ui';
import { enabledServices } from '../content/services';
import { whatsappLink } from '../utils/links';

const { locale = 'en' as Locale } = Astro.props;
const svc = enabledServices();
---

<BaseLayout locale={locale} path="/request-service/" title={`Request Service — ${site.name}`} description="Request forklift service from NEEL ENTERPRISES — equipment details, fault description, location and photographs.">
  <section class="section-pad">
    <div class="container-neel max-w-2xl">
      <p class="label-mono">Service request</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight md:text-5xl">Tell us what's stopped.</h1>
      <p class="mt-4 text-muted">Equipment → Problem → Location → Contact → Attachments. Fields marked optional can be skipped if unknown.</p>

      <!--
        Submits to the Cloudflare Pages Function /api/enquiry (functions/api/enquiry.ts):
        Turnstile + honeypot, server-side validation, Supabase persistence,
        email notification, reference number. WhatsApp prefilled fallback
        remains as the no-JS path.
      -->
      <form id="service-request" class="mt-10 space-y-8" method="get" action={whatsappLink()}>
        <fieldset>
          <legend class="label-mono">1 · Equipment</legend>
          <div class="mt-3 grid gap-4 sm:grid-cols-2">
            <label class="block text-sm font-medium">Equipment type
              <select name="equipment_type" class="mt-1 w-full rounded border border-line bg-elevated p-2">
                <option>Electric forklift</option><option>Diesel forklift</option>
                <option>Pallet truck</option><option>Tow tractor</option><option>Other</option>
              </select>
            </label>
            <label class="block text-sm font-medium">Brand (optional)
              <input name="brand" class="mt-1 w-full rounded border border-line bg-elevated p-2" />
            </label>
            <label class="block text-sm font-medium">Model (optional)
              <input name="model" class="mt-1 w-full rounded border border-line bg-elevated p-2" />
            </label>
            <label class="block text-sm font-medium">Capacity (optional)
              <input name="capacity" class="mt-1 w-full rounded border border-line bg-elevated p-2" />
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend class="label-mono">2 · Requirement</legend>
          <label class="mt-3 block text-sm font-medium">What do you need?
            <select name="requirement" class="mt-1 w-full rounded border border-line bg-elevated p-2">
              {svc.map((s) => <option>{s.title}</option>)}
            </select>
          </label>
          <label class="mt-4 block text-sm font-medium">Describe the problem (optional)
            <textarea name="description" rows="4" class="mt-1 w-full rounded border border-line bg-elevated p-2"></textarea>
          </label>
          <label class="mt-4 block text-sm font-medium">Urgency
            <select name="urgency" class="mt-1 w-full rounded border border-line bg-elevated p-2">
              <option>Equipment stopped — urgent</option><option>Degraded but working</option><option>Planned / scheduled</option>
            </select>
          </label>
        </fieldset>

        <fieldset>
          <legend class="label-mono">3 · Location</legend>
          <div class="mt-3 grid gap-4 sm:grid-cols-2">
            <label class="block text-sm font-medium">City
              <input name="city" required class="mt-1 w-full rounded border border-line bg-elevated p-2" />
            </label>
            <label class="block text-sm font-medium">State (optional)
              <input name="state" class="mt-1 w-full rounded border border-line bg-elevated p-2" />
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend class="label-mono">4 · Contact</legend>
          <div class="mt-3 grid gap-4 sm:grid-cols-2">
            <label class="block text-sm font-medium">Name
              <input name="name" required autocomplete="name" class="mt-1 w-full rounded border border-line bg-elevated p-2" />
            </label>
            <label class="block text-sm font-medium">Company (optional)
              <input name="company" autocomplete="organization" class="mt-1 w-full rounded border border-line bg-elevated p-2" />
            </label>
            <label class="block text-sm font-medium">Phone / WhatsApp
              <input name="phone" type="tel" required autocomplete="tel" class="mt-1 w-full rounded border border-line bg-elevated p-2" />
            </label>
            <label class="block text-sm font-medium">Email
              <input name="email" type="email" required autocomplete="email" class="mt-1 w-full rounded border border-line bg-elevated p-2" />
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend class="label-mono">5 · Attachments</legend>
          <!-- Phase 7 (Cloudinary): validated upload flow. Describe attachments
               in the problem field meanwhile, or send via WhatsApp. -->
          <label class="mt-3 block text-sm font-medium">Equipment photographs / documents (optional)
            <input type="file" name="attachments" multiple accept="image/*,.pdf" class="mt-1 block w-full text-sm" />
          </label>
          <p class="mt-1 text-xs text-muted">Note: files are not uploaded yet — please also send photographs via WhatsApp after submitting.</p>
        </fieldset>

        <label class="flex items-start gap-3 text-sm">
          <input type="checkbox" name="consent" required class="mt-1" />
          <span>I agree that NEEL ENTERPRISES may use these details to respond to my enquiry, as described in the
            <a class="text-accent underline" href={`/${locale === 'en' ? '' : locale + '/'}privacy-policy/`}>privacy policy</a>.</span>
        </label>

        <!-- Honeypot: hidden from humans, filled by bots -->
        <label class="hidden" aria-hidden="true">Website
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>

        <!-- TODO: Turnstile widget — rendered here once TURNSTILE_SITE_KEY is configured -->

        <button type="submit" class="btn btn-primary w-full justify-center text-lg">{t(locale, 'cta.requestService')}</button>

        <div id="form-error" class="hidden rounded-sm border border-red-500/50 bg-red-500/10 p-4 text-sm text-red-600 dark:text-red-400" role="alert"></div>

        <div id="form-success" class="hidden rounded-sm border-2 border-accent bg-elevated p-6" role="status">
          <p class="text-lg font-bold">Your service request has been received.</p>
          <p class="mt-2 text-sm text-muted">Reference number:</p>
          <p class="font-mono text-xl font-bold text-accent" id="form-reference"></p>
          <p class="mt-2 text-xs text-muted" id="form-email-status"></p>
          <a id="form-whatsapp" href="#" class="btn btn-primary mt-4" rel="noopener">Continue on WhatsApp ↗</a>
          <p class="mt-2 text-xs text-muted">Keep this reference for follow-up.</p>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('service-request') as HTMLFormElement | null;
  if (form) {
    const errorBox = document.getElementById('form-error')!;
    const successBox = document.getElementById('form-success')!;
    form.addEventListener('submit', async (e) => {
      // No-JS / not-yet-deployed fallback: native GET → WhatsApp remains.
      if (!window.fetch || location.protocol === 'file:') return;
      e.preventDefault();
      errorBox.classList.add('hidden');
      const fd = new FormData(form);
      const payload: Record<string, unknown> = Object.fromEntries(fd.entries());
      payload.consent = fd.get('consent') === 'on';
      payload.locale = document.documentElement.lang || 'en';
      delete (payload as Record<string, unknown>).attachments;

      try {
        const res = await fetch('/api/enquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json() as {
          ok: boolean; reference?: string; stored?: boolean; emailSent?: boolean;
          whatsappFollowUp?: string; error?: string; errors?: Record<string, string>;
        };

        if (!res.ok || !data.ok) {
          errorBox.textContent =
            data.errors ? Object.values(data.errors).join(' ') :
            data.error ?? 'Something went wrong. Please try again, or reach us on WhatsApp.';
          errorBox.classList.remove('hidden');
          return;
        }

        form.querySelectorAll('fieldset, button, label').forEach((el) => (el as HTMLElement).style.display = 'none');
        document.getElementById('form-reference')!.textContent = data.reference ?? '';
        document.getElementById('form-email-status')!.textContent = data.emailSent
          ? 'A confirmation has been sent to your email.'
          : '';
        (document.getElementById('form-whatsapp') as HTMLAnchorElement).href = data.whatsappFollowUp ?? '#';
        successBox.classList.remove('hidden');
        successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch {
        // Endpoint unreachable (e.g. local static preview): hand off to WhatsApp.
        form.method = 'get';
        form.submit();
      }
    });
  }
</script>
