---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { t, type Locale } from '../i18n/ui';
import { brands } from '../content/misc';

const { locale = 'en' as Locale } = Astro.props;
---

<BaseLayout locale={locale} path="/about/" title={`About — ${site.name}`} description={`About NEEL ENTERPRISES: ${site.facts.yearsExperience} years of experience in electric and diesel forklift service and spare parts for material handling equipment.`}>
  <section class="section-pad">
    <div class="container-neel max-w-3xl">
      <p class="label-mono">About</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight md:text-5xl">Service built around uptime.</h1>

      <div class="mt-8 space-y-5 text-lg text-muted">
        <p>
          <strong class="text-ink">NEEL ENTERPRISES</strong> is a service provider for both electric and diesel
          forklifts, and supplies quality spare parts for material handling equipment. The company's work is built on
          technical capability, commitment, in-time supply of spares and service support — following applicable
          technical safety norms.
        </p>
        <p>
          We work closely with industries including automobile, engineering, pharma and warehousing, providing
          effective solutions for their material handling challenges. Our technical team has
          {site.facts.yearsExperience} years' professional experience in material handling equipment.
        </p>
      </div>

      <h2 class="mt-12 text-2xl font-bold">What we do</h2>
      <ul class="mt-4 grid gap-2 text-muted sm:grid-cols-2">
        <li>— Electric & diesel forklift repair</li>
        <li>— Preventive maintenance & AMC</li>
        <li>— Engine & transmission overhauling</li>
        <li>— Battery sales, service & reconditioning</li>
        <li>— Traction controller repair & service</li>
        <li>— Spare parts supply</li>
        <li>— Forklift rental services</li>
        <li>— Qualified technical staff</li>
      </ul>

      <h2 class="mt-12 text-2xl font-bold">Technical experience</h2>
      <p class="mt-3 text-muted">Our technicians' experience with major material handling brands:</p>
      <div class="mt-4 space-y-3">
        {site.facts.staffTiers.map((tier) => (
          <div class="rounded border border-line bg-elevated p-4">
            <p class="font-semibold">{tier.years}+ years</p>
            <p class="text-sm text-muted">{tier.brands ? tier.brands.join(' · ') : tier.note}</p>
          </div>
        ))}
      </div>

      <h2 class="mt-12 text-2xl font-bold">Brand experience</h2>
      <div class="mt-4 flex flex-wrap gap-3">
        {brands.map((b) => <img src={b.logo} alt={b.name} loading="lazy" width="90" height="45" class="h-10 w-auto rounded border border-line object-contain p-1" />)}
      </div>
      <p class="mt-3 text-sm text-muted">Brand names indicate technical experience with the equipment, not authorized dealership or partnership.</p>

      <h2 class="mt-12 text-2xl font-bold">Offices</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {site.addresses.map((a) => (
          <div class="rounded border border-line bg-elevated p-5">
            <p class="label-mono">{a.label}</p>
            <p class="mt-2">{a.lines.join(', ')}</p>
            <a class="mt-2 inline-block text-sm font-semibold text-accent" href={a.mapsUrl} target="_blank" rel="noopener">Google Maps ↗</a>
          </div>
        ))}
      </div>

      <a href={`/${locale === 'en' ? '' : locale + '/'}contact/`} class="mt-12 inline-block rounded bg-accent px-5 py-3 font-semibold text-white hover:opacity-90">{t(locale, 'nav.contact')} →</a>
    </div>
  </section>
</BaseLayout>
