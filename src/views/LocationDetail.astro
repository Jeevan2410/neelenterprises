---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { site } from '../config/site';
import type { Locale } from '../i18n/ui';
import { enabledServices } from '../content/services';
import { whatsappLink, emailLink } from '../utils/links';

const { locale = 'en' as Locale, slug } = Astro.props as { locale: Locale; slug: string };
const loc = site.addresses.find((a) => a.id === slug);
if (!loc) return Astro.redirect('/404/');
const path = `/locations/${slug}/`;
const svc = enabledServices().slice(0, 6);
---

<BaseLayout locale={locale} path={path} title={`Forklift Service in ${loc.city} — ${site.name}`} description={`${loc.label} of NEEL ENTERPRISES in ${loc.city}, ${loc.state} ${loc.postalCode}. Electric and diesel forklift repair, maintenance, spare parts and rental enquiries welcome.`}>
  <section class="section-pad">
    <div class="container-neel max-w-3xl">
      <Breadcrumbs locale={locale} crumbs={[
        { label: 'Locations', href: `/${locale === 'en' ? '' : locale + '/'}locations/` },
        { label: loc.city, href: path },
      ]} />
      <p class="label-mono mt-8">{loc.label}</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight md:text-5xl">{loc.city}</h1>
      <address class="mt-6 not-italic text-lg text-muted">{loc.lines.map((l) => <span class="block">{l}</span>)}</address>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={loc.mapsUrl} target="_blank" rel="noopener" class="rounded border border-line bg-elevated px-5 py-3 font-semibold hover:border-ink">Google Maps ↗</a>
        <a href={whatsappLink()} rel="noopener" class="rounded bg-accent px-5 py-3 font-semibold text-white hover:opacity-90">WhatsApp Us</a>
        <a href={emailLink(`Forklift service enquiry — ${loc.city}`)} class="rounded border border-line bg-elevated px-5 py-3 font-semibold hover:border-ink">Email Us</a>
      </div>
      <p class="mt-6 text-sm text-muted">Enquiries from across India are welcome; this page describes our {loc.label.toLowerCase()} in {loc.city}.</p>
      <h2 class="mt-12 text-2xl font-bold">Services</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {svc.map((s) => <li><a class="text-accent hover:underline" href={`/${locale === 'en' ? '' : locale + '/'}services/${s.slug}/`}>{s.title}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  address: {
    '@type': 'PostalAddress',
    streetAddress: loc.lines.join(', '),
    addressLocality: loc.city,
    addressRegion: loc.state,
    postalCode: loc.postalCode,
    addressCountry: 'IN',
  },
  telephone: site.phone,
  email: site.email,
  url: loc.mapsUrl,
})} />
