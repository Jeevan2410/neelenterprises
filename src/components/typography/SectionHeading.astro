---
interface Props {
  eyebrow?: string;
  title: string;
  class?: string;
}
const { eyebrow, title, class: cls = '' } = Astro.props;
---

<div class={cls} data-reveal>
  {eyebrow && <p class="label-mono">{eyebrow}</p>}
  <h2 class="mt-2 text-3xl font-black tracking-tight md:text-4xl">{title}</h2>
</div>
