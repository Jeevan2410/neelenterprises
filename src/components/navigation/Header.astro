---
import { site } from '../../config/site';
import { t, locales, localePath, type Locale } from '../../i18n/ui';

const { locale, currentPath } = Astro.props as { locale: Locale; currentPath: string };
const base = locale === 'en' ? '' : `/${locale}`;
const items = [
  { key: 'about', href: `${base}/about/` },
  { key: 'services', href: `${base}/services/` },
  { key: 'industries', href: `${base}/industries/` },
  { key: 'brands', href: `${base}/brands/` },
  { key: 'locations', href: `${base}/locations/` },
  { key: 'faq', href: `${base}/faq/` },
  { key: 'contact', href: `${base}/contact/` },
] as const;
const isActive = (href: string) => currentPath === href || (href !== `${base}/` && currentPath.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
  <div class="container-neel flex h-16 items-center justify-between gap-4">
    <a href={localePath(locale, '/')} class="flex items-center gap-3" aria-label={`${site.name} — home`}>
      <img src="/images/brand/logo.png" alt="NEEL ENTERPRISES logo" width="36" height="37" class="rounded bg-elevated" />
      <span class="text-sm font-black uppercase tracking-widest">NEEL<span class="text-accent"> ENTERPRISES</span></span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
      {items.map(({ key, href }) => (
        <a
          href={href}
          aria-current={isActive(href) ? 'page' : undefined}
          class:list={[
            'group relative text-sm font-medium transition-colors',
            isActive(href) ? 'text-ink' : 'text-muted hover:text-ink',
          ]}
        >
          {t(locale, `nav.${key}`)}
          <span
            class:list={[
              'absolute -bottom-1.5 left-0 h-px w-full origin-left bg-accent transition-transform duration-300',
              isActive(href) ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100',
            ]}
            aria-hidden="true"
          />
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <label class="sr-only" for="lang-select">Language</label>
      <select id="lang-select" class="rounded-sm border border-line bg-elevated px-2 py-1.5 font-mono text-xs" data-lang-switch data-current={currentPath}>
        {locales.map((l) => <option value={l} selected={l === locale}>{l.toUpperCase()}</option>)}
      </select>
      <button id="theme-toggle" type="button" class="rounded-sm border border-line bg-elevated px-2.5 py-1.5 font-mono text-xs" aria-label="Toggle dark mode">◐</button>
      <a href={`${base}/request-service/`} class="btn btn-primary hidden !px-3.5 !py-1.5 text-xs sm:inline-flex">
        {t(locale, 'cta.requestService')}
      </a>
    </div>
  </div>

  <details class="lg:hidden">
    <summary class="container-neel flex cursor-pointer list-none items-center justify-between py-3 text-sm font-medium text-muted">
      Menu
      <span class="font-mono text-accent" aria-hidden="true">≡</span>
    </summary>
    <nav class="container-neel grid gap-2 pb-4" aria-label="Mobile">
      {items.map(({ key, href }) => (
        <a href={href} class:list={['rounded-sm border bg-elevated px-3 py-2.5 text-sm', isActive(href) ? 'border-accent font-semibold' : 'border-line']}>
          {t(locale, `nav.${key}`)}
        </a>
      ))}
    </nav>
  </details>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('neel-theme', dark ? 'dark' : 'light'); } catch {}
  });
  document.querySelector<HTMLSelectElement>('[data-lang-switch]')?.addEventListener('change', (e) => {
    const el = e.target as HTMLSelectElement;
    const current = el.dataset.current ?? '/';
    const stripped = current.replace(/^\/(kn|hi)(?=\/|$)/, '') || '/';
    const next = el.value === 'en' ? stripped : `/${el.value}${stripped === '/' ? '' : stripped}`;
    window.location.href = next;
  });
</script>
