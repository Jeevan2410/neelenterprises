---
import { site } from '../../config/site';
import { t, locales, localePath, type Locale } from '../../i18n/ui';

const { locale, currentPath } = Astro.props as { locale: Locale; currentPath: string };
const nav = (['about', 'services', 'industries', 'brands', 'locations', 'faq', 'contact'] as const)
  .map((k) => ({ href: localePath(locale, `/${k === 'contact' ? 'contact' : k}/`), label: t(locale, `nav.${k}`) }));
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
  <div class="container-neel flex h-16 items-center justify-between gap-4">
    <a href={localePath(locale, '/')} class="flex items-center gap-3" aria-label={`${site.name} — home`}>
      <img src="/images/brand/logo.png" alt="NEEL ENTERPRISES logo" width="36" height="37" class="rounded bg-elevated" />
      <span class="font-bold tracking-tight">NEEL<span class="text-accent"> ENTERPRISES</span></span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary">
      {nav.map((item) => <a href={item.href} class="text-sm font-medium text-muted hover:text-ink transition-colors">{item.label}</a>)}
    </nav>

    <div class="flex items-center gap-2">
      <label class="sr-only" for="lang-select">Language</label>
      <select id="lang-select" class="rounded border border-line bg-elevated px-2 py-1 text-sm" data-lang-switch data-current={currentPath}>
        {locales.map((l) => <option value={l} selected={l === locale}>{l.toUpperCase()}</option>)}
      </select>
      <button id="theme-toggle" type="button" class="rounded border border-line bg-elevated px-2 py-1 text-sm" aria-label="Toggle dark mode">◐</button>
      <a href={localePath(locale, '/request-service/')} class="hidden rounded bg-accent px-3 py-1.5 text-sm font-semibold text-white hover:opacity-90 sm:inline-block">
        {t(locale, 'cta.requestService')}
      </a>
    </div>
  </div>

  <details class="lg:hidden">
    <summary class="container-neel cursor-pointer list-none py-2 text-sm font-medium text-muted">Menu</summary>
    <nav class="container-neel grid gap-2 pb-4" aria-label="Mobile">
      {nav.map((item) => <a href={item.href} class="rounded border border-line bg-elevated px-3 py-2 text-sm">{item.label}</a>)}
    </nav>
  </details>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('neel-theme', dark ? 'dark' : 'light'); } catch {}
  });
  document.querySelector<HTMLSelectElement>('[data-lang-switch]')?.addEventListener('change', (e) => {
    const el = e.target as HTMLSelectElement;
    const current = el.dataset.current ?? '/';
    // strip existing locale prefix, then re-prefix with selection
    const stripped = current.replace(/^\/(kn|hi)(?=\/|$)/, '') || '/';
    const next = el.value === 'en' ? stripped : `/${el.value}${stripped === '/' ? '' : stripped}`;
    window.location.href = next;
  });
</script>
