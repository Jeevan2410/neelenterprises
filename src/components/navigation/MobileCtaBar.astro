---
import { t, type Locale } from '../../i18n/ui';
import { whatsappLink, emailLink } from '../../utils/links';
const { locale } = Astro.props as { locale: Locale };
---

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-line bg-elevated/95 backdrop-blur sm:hidden" role="navigation" aria-label="Quick contact">
  <a href={whatsappLink()} class="py-3 text-center text-xs font-semibold text-accent">{t(locale, 'cta.whatsapp')}</a>
  <a href={emailLink()} class="py-3 text-center text-xs font-semibold border-x border-line">{t(locale, 'cta.email')}</a>
  <a href={`/${locale === 'en' ? '' : locale + '/'}request-service/`} class="py-3 text-center text-xs font-semibold bg-accent text-white">{t(locale, 'cta.requestService')}</a>
</div>
