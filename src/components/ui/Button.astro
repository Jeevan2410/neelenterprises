---
interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'quiet';
  external?: boolean;
  class?: string;
  ariaLabel?: string;
}
const { href, variant = 'primary', external = false, class: cls = '', ariaLabel } = Astro.props;
---

<a
  href={href}
  class:list={['btn', `btn-${variant}`, cls]}
  aria-label={ariaLabel}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
><slot /></a>
